# Case study: webhooks during an app deploy
# bareproxy 0.16.0, built with go1.27.3, 2026-10-31 10:40:55 UTC, Linux x86_64

## Config (secrets are random per run; the paths are a temp folder)

global
  admin /work/admin.sock
  state /work/state
  trace-log /work/requests.log 10MB 2

site http://hooks.test:36707
  route /hooks/github -> inbox github
  route /hooks/stripe -> inbox stripe
  route /hooks/shopify -> inbox shopify

inbox github
  deliver app
  signature github /work/github-secret
  key-header X-GitHub-Delivery

inbox stripe
  deliver app
  signature stripe /work/stripe-secret

inbox shopify
  deliver app
  signature shopify /work/shopify-secret
  key-header X-Shopify-Webhook-Id

pool app
  backend 127.0.0.1:40513

