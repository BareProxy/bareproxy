# Case study: a DNS move that went wrong
# bareproxy 0.16.0, built with go1.27.3, 2026-10-31 10:41:06 UTC, Linux x86_64
# DNS and HTTPS from lib/fakenet.py on 127.0.0.1 (resolver port 56839, TLS port 53711)

## Config

global
  state /work/state

drift acme
  domains acme.test www.acme.test shop.acme.test blog.acme.test
  domains api.acme.test status.otherco.test
  resolver 127.0.0.1:56839
  port 53711
  ca /work/ca-bundle.pem
  timeout 2s

